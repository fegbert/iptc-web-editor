generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model WorkspaceFileData {
  id            String         @id @default(cuid())
  name          String
  type          String
  size          Float
  lastModified  String
  path          String?
  workspaceFile WorkspaceFile?
}

model WorkspaceFile {
  id         String            @id @default(cuid())
  clerkOrgId String
  r2Key      String            @unique
  metadata   Json              @default("{}")
  fileDataId String            @unique
  fileData   WorkspaceFileData @relation(fields: [fileDataId], references: [id])
  createdBy  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}
